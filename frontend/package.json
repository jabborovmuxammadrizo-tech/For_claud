{
  "name": "pdf-test-designer",
  "productName": "PDF Test Designer",
  "version": "1.0.0",
  "description": "PDF Test Designer — Mirzo Ulugbek NTM. One-click professional examination PDFs.",
  "author": "MIRZO ULUGBEK NTM",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && npm run gen:installer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never",
    "start": "electron .",
    "gen:installer": "node scripts/gen-installer-nsh.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.5",
    "lucide-react": "0.511.0",
    "pdfjs-dist": "4.10.38",
    "postcss": "8.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "build": {
    "appId": "uz.mirzoulugbek.pdftestdesigner",
    "productName": "PDF Test Designer",
    "copyright": "© MIRZO ULUGBEK NTM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/ptd-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "PDF Test Designer",
      "artifactName": "PDF_Test_Designer_Portable.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Test Designer",
      "menuCategory": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "PDF Test Designer — Mirzo Ulugbek NTM",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PDF_Test_Designer_Setup.${ext}"
    },
    "portable": {
      "artifactName": "PDF_Test_Designer_Standalone.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "executableName": "pdf-test-designer"
    }
  }
}
