    "autoprefixer": "10.4.21",
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.5",
    "lucide-react": "0.511.0",
    "pdfjs-dist": "4.10.38",
    "postcss": "8.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
