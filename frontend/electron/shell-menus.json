      "items": [
        { "key": "01_branded", "label": "Generate Branded PDF", "args": "--shell=generate-default", "setting": "shell_default_action" },
        { "key": "02_generate_default", "label": "Generate Using Default Template", "args": "--shell=generate-default", "setting": "shell_default_action" },
        { "key": "03_generate_using", "label": "Generate Using...", "args": "--shell=generate-template" },
        { "key": "04_editor", "label": "Open in Document Editor", "args": "--shell=edit", "separatorBefore": true },
        { "key": "05_images", "label": "Extract Images", "args": "--shell=extract" },
        { "key": "06_pdf", "label": "Convert to PDF", "args": "--shell=convert-pdf" },
        { "key": "07_batch_default", "label": "Batch Generate Using Default Template", "args": "--shell=batch-generate", "setting": "shell_batch", "separatorBefore": true },
        { "key": "08_batch_using", "label": "Batch Generate Using...", "args": "--shell=batch-generate --pick-template", "setting": "shell_batch" },
        { "key": "09_open_all", "label": "Open All in PDF Test Designer", "args": "--shell=open", "setting": "shell_batch" }
      ]
    },
    {
      "id": "folder",
      "setting": "shell_menu_folder",
      "roots": ["Directory"],
      "items": [
        { "key": "01_generate_all", "label": "Generate All Supported Documents", "args": "--shell=batch-generate", "setting": "shell_default_action" },
        { "key": "02_batch_default", "label": "Batch Generate Using Default Template", "args": "--shell=batch-generate", "setting": "shell_batch" },
        { "key": "03_batch_using", "label": "Batch Generate Using...", "args": "--shell=batch-generate --pick-template", "setting": "shell_batch" },
        { "key": "04_open_folder", "label": "Open Folder in PDF Test Designer", "args": "--shell=open-folder" }
      ]
    },
    {
      "id": "image",
      "setting": "shell_menu_image",
      "roots": ["SystemFileAssociations\\.png", "SystemFileAssociations\\.jpg", "SystemFileAssociations\\.jpeg", "SystemFileAssociations\\.bmp", "SystemFileAssociations\\.tif", "SystemFileAssociations\\.tiff"],
      "items": [
        { "key": "01_library", "label": "Add to Image Library", "args": "--shell=image-library" },
        { "key": "02_pdf", "label": "Create PDF From Image", "args": "--shell=image-pdf" },
        { "key": "03_editor", "label": "Open in Image Editor", "args": "--shell=image-editor" },
        { "key": "04_background", "label": "Use as Document Background", "args": "--shell=image-background", "separatorBefore": true },
        { "key": "05_watermark", "label": "Use as Watermark", "args": "--shell=image-watermark" }
      ]
    }
