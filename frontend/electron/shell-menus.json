        { "key": "02_generate_using", "label": "Generate PDF Using...", "args": "--shell=generate-template" },
        { "key": "03_open", "label": "Open in PDF Test Designer", "args": "--shell=open" },
        { "key": "04_edit", "label": "Edit Document", "args": "--shell=edit" },
        { "key": "05_extract", "label": "Extract Text and Images", "args": "--shell=extract", "separatorBefore": true },
        { "key": "06_editable", "label": "Convert to Editable Document", "args": "--shell=convert-editable" },
        { "key": "07_compress", "label": "Compress PDF", "args": "--shell=compress" },
        { "key": "08_grayscale", "label": "Convert to Grayscale", "args": "--shell=grayscale" },
        { "key": "09_info", "label": "View Document Information", "args": "--shell=info" },
        { "key": "10_batch_default", "label": "Batch Generate Using Default Template", "args": "--shell=batch-generate", "setting": "shell_batch", "separatorBefore": true },
        { "key": "11_batch_using", "label": "Batch Generate Using...", "args": "--shell=batch-generate --pick-template", "setting": "shell_batch" },
        { "key": "12_open_all", "label": "Open All in PDF Test Designer", "args": "--shell=open", "setting": "shell_batch" }
